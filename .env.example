# 本地 PostgreSQL（默认，优先）
DATABASE_URL=postgresql://flowledger:flowledger@localhost:5432/flowledger
PG_HOST=localhost
PG_PORT=5432
PG_USER=flowledger
PG_DB=flowledger
PG_SUPERUSER=postgres

# 投资权威库（invest.lcteam 持仓/快照）
INVEST_DATABASE_URL=postgresql://qiubin@localhost:5432/invest

# 本地服务
API_PORT=9011
WEB_PORT=5011
API_URL=http://localhost:9011
WEB_URL=http://localhost:5011
NEXT_PUBLIC_API_URL=http://localhost:9011
LOG_LEVEL=INFO

# 可选：设为 1 时回退使用 Docker PostgreSQL
# USE_DOCKER_PG=0
