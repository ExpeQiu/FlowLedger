<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flowledger.start</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__FLOWLEDGER_ROOT__/scripts/autostart.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__FLOWLEDGER_ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__FLOWLEDGER_ROOT__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__FLOWLEDGER_ROOT__/logs/launchd.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
