# 本地 PostgreSQL（默认，优先）
DATABASE_URL=postgresql://flowledger:flowledger@localhost:5432/flowledger
PG_HOST=localhost
PG_PORT=5432
PG_USER=flowledger
PG_DB=flowledger
PG_SUPERUSER=postgres

# 本地服务
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO

# 可选：设为 1 时回退使用 Docker PostgreSQL
# USE_DOCKER_PG=0
